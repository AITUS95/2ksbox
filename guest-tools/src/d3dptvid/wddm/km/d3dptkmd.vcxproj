<?xml version="1.0" encoding="utf-8"?>
<!--
  d3dptkmd.sys: the WDDM kernel-mode driver (M18 step 2, ADR-022).
  Built by guest-tools/build-wddm.cmd inside the EWDK (WDK 10.0.19041 and
  VS 2019's v142 build tools), the last kit that targets Windows 7 and
  32-bit kernel drivers. docs/build-windows.md "The WDDM driver".
  ARM64 is built as our viogpudo is, by scripts/build-windows.sh: Visual
  Studio 2022 with NuGet's WDK 10.0.26100, whose props D3DPT_WDK_PROPS
  names (track M25: Windows 11 on Arm refused the EWDK's build, Code 48).
-->
<Project DefaultTargets="Build" ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <!-- x64: Windows 11 (track M20), test signed in the guest -->
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <!-- ARM64: Windows 11 on Arm (track M25), test signed the same way -->
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6D3A2B1E-7C44-4E0B-9B57-3D00D3D7A001}</ProjectGuid>
    <RootNamespace>d3dptkmd</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(D3DPT_WDK_PROPS)" Condition="'$(D3DPT_WDK_PROPS)' != ''" />
  <PropertyGroup Condition="'$(D3DPT_WDK_PROPS)' != ''">
    <WindowsTargetPlatformVersion>$(D3DPT_WDK_VER)</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion Condition="'$(Platform)'=='Win32'">Windows7</TargetVersion>
    <TargetVersion Condition="'$(Platform)'=='x64'">Windows10</TargetVersion>
    <TargetVersion Condition="'$(Platform)'=='ARM64'">Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <!-- unsigned: 32-bit Windows 7 loads it after a prompt -->
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>d3dptkmd</TargetName>
    <OutDir>$(D3DPT_OUT)\</OutDir>
    <IntDir>$(D3DPT_OUT)\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- d3dpt_fb.h includes <stdint.h>, which the kernel-mode include
           path lacks (MSVC's own drags in the user-mode CRT): kinc/ -->
      <AdditionalIncludeDirectories>kinc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Arm: a volatile access is ordered (acquire / release), as on x86,
           so a register write that starts the device follows the writes to
           memory before it; MSVC's Arm default (/volatile:iso) orders
           nothing -->
      <AdditionalOptions Condition="'$(Platform)'=='ARM64'">/volatile:ms %(AdditionalOptions)</AdditionalOptions>
      <!-- the newer kit deprecates ExAllocatePoolWithTag, which the
           Windows 7 build needs; the same calls on both kits -->
      <DisableSpecificWarnings Condition="'$(D3DPT_WDK_PROPS)' != ''">4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <AdditionalDependencies>displib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="d3dptkmd.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
