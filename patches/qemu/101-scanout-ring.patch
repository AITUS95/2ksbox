+static bool pixels_wanted;
+
 static void console_hw_update_bh(void *con)
 {
+    /* a screendump's update: the surface itself is read (2ksbox) */
+    pixels_wanted = true;
     qemu_console_hw_update(con);
+    pixels_wanted = false;
+}
