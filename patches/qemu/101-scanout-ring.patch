index 65ddb4c..c6d7943 100644
--- a/include/ui/console.h
+++ b/include/ui/console.h
@@ -458,6 +458,34 @@ void qemu_host_vblank(void);
  */
 void qemu_host_set_refresh_mhz(uint32_t mhz);
 uint32_t qemu_host_refresh_mhz(void);
+/*
+ * A scanout ring (2ksbox, track M26): images on the host's GPU, made by
+ * the front end, that a display device whose frames are rendered on that
+ * GPU fills there and shows by number, so a frame never leaves the GPU.
+ * `alloc` asks for `count` images of width x height BGRA8 for `con` and
+ * fills `handles` (shared D3D12 resources on Windows, MTLHeaps on
+ * macOS, opaque fds on Linux; the front end's; count 0 releases); it
+ * returns how many it made, 0 for no ring. `show` puts slot `slot` on
+ * `con` as its whole frame, the slot's GPU work already finished. `held`
+ * (any thread): bit n set while the front end may still sample slot n
+ * (shown, and not given back), which the device must not write. Main
+ * loop or vCPU thread, BQL held. None registered (a plain qemu-system):
+ * devices keep their surfaces.
+ */
+typedef struct QemuScanoutRingOps {
+    int (*alloc)(QemuConsole *con, int width, int height, int count,
+                 void **handles);
+    void (*show)(QemuConsole *con, int slot);
+    uint32_t (*held)(QemuConsole *con);
+} QemuScanoutRingOps;
+void qemu_scanout_ring_register(const QemuScanoutRingOps *ops);
+const QemuScanoutRingOps *qemu_scanout_ring(void);
+/*
+ * True during a device's update that a screendump asked for: the surface
+ * itself is about to be read, so a device showing a ring slot puts the
+ * frame there first.
+ */
+bool qemu_console_pixels_wanted(void);
 void qemu_console_notify(QemuConsoleEventType type, QemuConsole *con);
 
