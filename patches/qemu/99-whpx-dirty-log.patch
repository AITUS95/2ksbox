+/*
+ * 2ksbox: a RAM region with a dirty log (a display adapter's VRAM) is
+ * mapped with the hypervisor tracking its dirty pages, and log_sync asks
+ * the hypervisor which ones the guest wrote. log_sync marked the whole
+ * region dirty on every call before, so a display redrew, copied and
+ * uploaded its whole frame at every refresh whatever changed, a cost that
+ * grows with the mode (a 3840x2160 desktop is 33 MB a refresh).
+ * WHPX_DIRTY_TRACK=0 keeps the old whole-region answer, the A/B.
+ */
+static bool whpx_dirty_track(MemoryRegion *mr, bool writable)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("WHPX_DIRTY_TRACK");
+        on = whp_dispatch.WHvQueryGpaRangeDirtyBitmap && !(e && !strcmp(e, "0"));
+    }
+    return on && writable &&
+           (memory_region_get_dirty_log_mask(mr) & ~(1 << DIRTY_MEMORY_CODE));
+}
+
 static void whpx_set_phys_mem(MemoryRegionSection *section, bool add)
 {
     struct whpx_state *whpx = &whpx_global;
@@ -330,6 +352,16 @@ static void whpx_set_phys_mem(MemoryRegionSection *section, bool add)
      | (writable ? WHvMapGpaRangeFlagWrite : 0);
     mem = memory_region_get_ram_ptr(area) + section->offset_within_region;
 
+    if (whpx_dirty_track(area, writable)) {
+        hr = whp_dispatch.WHvMapGpaRange(whpx->partition, mem, gva, size,
+                                         flags | WHvMapGpaRangeFlagTrackDirtyPages);
+        if (SUCCEEDED(hr)) {
+            return;
+        }
+        /* a hypervisor without it: log_sync's query then fails, and the
+         * whole section is dirty at every sync, as before */
+        warn_report_once("WHPX: no dirty page tracking (0x%08lx)", (unsigned long)hr);
+    }
     hr = whp_dispatch.WHvMapGpaRange(whpx->partition,
          mem, gva, size, flags);
     if (FAILED(hr)) {
@@ -392,16 +424,66 @@ static void whpx_transaction_commit(MemoryListener *listener)
 {
 }
 
+/* a section's logging turned on or off: map it again, with or without the
+ * hypervisor tracking its pages (whpx_dirty_track) */
+static void whpx_log_remap(MemoryRegionSection *section)
+{
+    if (memory_region_is_ram(section->mr) && !section->mr->readonly &&
+        !section->mr->rom_device) {
+        whpx_set_phys_mem(section, false);
+        whpx_set_phys_mem(section, true);
+    }
+}
+
+static void whpx_log_start(MemoryListener *listener,
+                           MemoryRegionSection *section, int old, int new)
+{
+    if (old == 0) {
+        whpx_log_remap(section);
+    }
+}
+
+static void whpx_log_stop(MemoryListener *listener,
+                          MemoryRegionSection *section, int old, int new)
+{
+    if (new == 0) {
+        whpx_log_remap(section);
+    }
+}
+
 static void whpx_log_sync(MemoryListener *listener,
                          MemoryRegionSection *section)
 {
+    struct whpx_state *whpx = &whpx_global;
     MemoryRegion *mr = section->mr;
+    uint64_t size = int128_get64(section->size);
+    uint64_t page_size = qemu_real_host_page_size();
+    uint64_t gpa = section->offset_within_address_space;
 
     if (!memory_region_is_ram(mr)) {
         return;
     }
 
-    memory_region_set_dirty(mr, 0, int128_get64(section->size));
+    if (whp_dispatch.WHvQueryGpaRangeDirtyBitmap &&
+        QEMU_IS_ALIGNED(size, page_size) && QEMU_IS_ALIGNED(gpa, page_size)) {
+        /* the pages written since the last query, which clears them: one
+         * bit a page, little endian in 64-bit words as QEMU's lebitmap */
+        uint64_t pages = size / page_size;
+        UINT32 bytes = DIV_ROUND_UP(pages, 64) * 8;
+        g_autofree uint64_t *bitmap = g_malloc0(bytes);
+
+        if (SUCCEEDED(whp_dispatch.WHvQueryGpaRangeDirtyBitmap(
+                whpx->partition, gpa, size, bitmap, bytes))) {
+            physical_memory_set_dirty_lebitmap(
+                (unsigned long *)bitmap,
+                memory_region_get_ram_addr(mr) + section->offset_within_region,
+                pages);
+            return;
+        }
+    }
+    /* not tracked (no logging asked for, an unaligned section, a hypervisor
+     * without it): all of it may have changed */
+    memory_region_set_dirty(mr, section->offset_within_region, size);
 }
 
