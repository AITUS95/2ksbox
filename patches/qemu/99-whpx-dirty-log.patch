     .commit = whpx_transaction_commit,
     .region_add = whpx_region_add,
     .region_del = whpx_region_del,
+    .log_start = whpx_log_start,
+    .log_stop = whpx_log_stop,
     .log_sync = whpx_log_sync,
     .priority = MEMORY_LISTENER_PRIORITY_ACCEL,
 };
